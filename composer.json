{
    "name": "sesi/central-conteudo",
    "description": "Central de conteúdo escolar Sesi: recados, provas, tarefas, cardápio, eventos e TV da entrada.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=7.4",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": { "App\\": "app/" }
    },
    "autoload-dev": {
        "psr-4": { "Tests\\": "tests/" }
    },
    "scripts": {
        "serve": "php -S localhost:8000 -t public",
        "test": "phpunit --bootstrap tests/bootstrap.php tests"
    }
}
