# Permite abrir o sistema em http://localhost/projeto/ (XAMPP): tudo é encaminhado para /public.
# Assim as pastas app, config, database e storage nunca ficam acessíveis pelo navegador.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^public/ - [L]
    RewriteRule ^$ public/ [L]
    RewriteRule (.*) public/$1 [L]
</IfModule>
